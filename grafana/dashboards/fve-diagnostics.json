            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "orange",
                "value": 20000
              },
              {
                "color": "red",
                "value": 45000
              }
            ]
          }
        },
        "overrides": []
