          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.\"Day\"::timestamp AS time, d.\"ExpectedCumulative\" AS \"Tempo minulého období\", s.\"MinDailyValue\" * d.\"DayIndex\" AS \"Tempo nejnižšího období\", s.\"MaxDailyValue\" * d.\"DayIndex\" AS \"Tempo nejvyššího období\", s.\"AvgDailyValue\" * d.\"DayIndex\" AS \"Průměrné tempo\", d.\"ActualCumulative\" AS \"Skutečnost\", d.\"ForecastCumulative\" AS \"Predikce\" FROM \"GaugeBillingDaily\" d LEFT JOIN \"GaugeBillingSpread\" s ON s.\"GaugeId\" = d.\"GaugeId\" WHERE d.\"GaugeId\" = $gauge ORDER BY 1"
        }
