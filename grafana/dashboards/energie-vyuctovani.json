          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * (\"TotalValue\" / NULLIF(\"PreviousPeriodValue\", 0) - 1), 1) AS \"Změna\" FROM \"GaugeBillingForecast\" WHERE \"GaugeId\" = $gauge"
        }
