          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT p.\"PeriodFrom\"::timestamp AS time, p.\"DailyValue\" AS \"Denní spotřeba období\", s.\"AvgDailyValue\" AS \"Průměr všech období\", NULL::numeric AS \"Aktuální období (odhad)\" FROM \"GaugeBillingPeriodStats\" p JOIN \"GaugeBillingSpread\" s ON s.\"GaugeId\" = p.\"GaugeId\" WHERE p.\"GaugeId\" = $gauge UNION ALL SELECT f.\"PeriodFrom\"::timestamp, NULL, s.\"AvgDailyValue\", f.\"TotalValue\" / f.\"DaysTotal\" FROM \"GaugeBillingForecast\" f JOIN \"GaugeBillingSpread\" s ON s.\"GaugeId\" = f.\"GaugeId\" WHERE f.\"GaugeId\" = $gauge ORDER BY 1"
        }
      ],
      "timeFrom": "10y"
