          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(\"PeriodTo\", 'DD.MM.YYYY') AS \"Konec\", to_char(\"LastDay\", 'DD.MM.YYYY') AS \"Data do\" FROM \"GaugeBillingForecast\" WHERE \"GaugeId\" = $gauge"
