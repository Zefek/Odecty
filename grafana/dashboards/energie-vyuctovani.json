          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(\"ExpectedBalance\") AS \"Vyúčtování\" FROM \"GaugeBillingForecast\" WHERE \"GaugeId\" = $gauge"
        }
      ]
