        "query": "SELECT \"Description\" AS __text, \"Id\" AS __value FROM \"Gauge\" ORDER BY \"Id\"",
        "definition": "SELECT \"Description\" AS __text, \"Id\" AS __value FROM \"Gauge\" ORDER BY \"Id\"",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "sort": 0
