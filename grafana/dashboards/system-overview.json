    {
      "id": 10,
      "type": "table",
      "title": "Souhrn – co naposledy hlásilo (nejhorší nahoře)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "grafana-postgresql-heater-diag" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "description": "Jeden řádek na komponentu: kdy naposledy dorazil záznam, jak dávno a kolikanásobek očekávaného intervalu to je.",
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "× interval" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1.5 },
                    { "color": "red", "value": 3 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Před (min)" },
            "properties": [ { "id": "unit", "value": "m" } ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "× interval", "desc": true } ] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT komponenta AS \"Komponenta\", last_seen AS \"Naposledy\", round((EXTRACT(EPOCH FROM (now() - last_seen)) / 60.0)::numeric, 0) AS \"Před (min)\", round((EXTRACT(EPOCH FROM (now() - last_seen)) / 60.0 / expected_min)::numeric, 1) AS \"× interval\" FROM ( SELECT 'Kotel (topení)' AS komponenta, max(timestamp) AS last_seen, 5.0 AS expected_min FROM heater_diagnostics UNION ALL SELECT 'Elektroměr (LSSensor)', max(timestamp), 5.0 FROM ls_sensor_diagnostics UNION ALL SELECT 'Garáž', max(timestamp), 15.0 FROM garage_diagnostics UNION ALL SELECT 'Vodoměr – kamera', max(timestamp), 5.0 FROM device_diagnostics UNION ALL SELECT 'Vodoměr – přenos', max(timestamp), 60.0 FROM transfer_diagnostics UNION ALL SELECT 'Vodoměr – rozpoznání', max(timestamp), 60.0 FROM file_diagnostics ) t ORDER BY (EXTRACT(EPOCH FROM (now() - last_seen)) / 60.0 / expected_min) DESC NULLS FIRST"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Reboots zařízení (24 h)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "grafana-postgresql-heater-diag" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "description": "Součet poklesů uptime (= rebootů) napříč kotlem, elektroměrem, garáží a kamerou za 24 h.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT (SELECT count(*) FROM (SELECT uptime_minutes, LAG(uptime_minutes) OVER (ORDER BY timestamp) prev FROM heater_diagnostics WHERE timestamp > now() - interval '24 hours') a WHERE prev IS NOT NULL AND uptime_minutes < prev) + (SELECT count(*) FROM (SELECT uptime_minutes, LAG(uptime_minutes) OVER (ORDER BY timestamp) prev FROM ls_sensor_diagnostics WHERE timestamp > now() - interval '24 hours') b WHERE prev IS NOT NULL AND uptime_minutes < prev) + (SELECT count(*) FROM (SELECT uptime_minutes, LAG(uptime_minutes) OVER (ORDER BY timestamp) prev FROM garage_diagnostics WHERE timestamp > now() - interval '24 hours') c WHERE prev IS NOT NULL AND uptime_minutes < prev) + (SELECT count(*) FROM (SELECT uptime_seconds, LAG(uptime_seconds) OVER (ORDER BY timestamp) prev FROM device_diagnostics WHERE timestamp > now() - interval '24 hours') d WHERE prev IS NOT NULL AND uptime_seconds < prev) AS reboots"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Chybové čítače kamery (od bootu)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "grafana-postgresql-heater-diag" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "description": "Nejnovější hodnota send_failures + tls_errors + camera_errors + ota_failures z device_diagnostics (kumulativní od posledního bootu).",
      "fieldConfig": {
        "defaults": {
