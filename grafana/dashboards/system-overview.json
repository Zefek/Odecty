    {
      "id": 20,
      "type": "timeseries",
      "title": "Tep systému – záznamů za 30 min (mezera = výpadek)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "grafana-postgresql-heater-diag" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "description": "Počet diagnostických záznamů v 30min oknech na každé zařízení. Souvislá řada = žije; prázdné okno = zařízení (nebo cesta k DB) v tu dobu nehlásilo.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": { "mode": "none" },
            "pointSize": 3
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', timestamp) + floor(extract(minute FROM timestamp)::int / 30) * interval '30 min' AS time, count(*) AS \"Kotel\" FROM heater_diagnostics WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', timestamp) + floor(extract(minute FROM timestamp)::int / 30) * interval '30 min' AS time, count(*) AS \"Elektroměr\" FROM ls_sensor_diagnostics WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "C",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', timestamp) + floor(extract(minute FROM timestamp)::int / 30) * interval '30 min' AS time, count(*) AS \"Garáž\" FROM garage_diagnostics WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "D",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', timestamp) + floor(extract(minute FROM timestamp)::int / 30) * interval '30 min' AS time, count(*) AS \"Vodoměr-kamera\" FROM device_diagnostics WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
